# This is also the live XDG config directory. Only share the desktop setup.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/dotfiles
!/config-paths.txt
!/packages/
!/tests/
!/hosts/
!/hypr/
!/zsh/
!/scripts/
!/kitty/
!/micro/
!/eza/
!/icons/
!/walker/
!/quickshell/
!/waybar/
!/fastfetch/
!/mako/
!/gtk-3.0/
!/gtk-4.0/
!/qt6ct/
!/Thunar/
!/MediaPlayer/
!/wallpapers/

# Preserve old checkouts on disk; use portable copies under lib/vendor.
/zsh/ohmyzsh/
/hypr/hyprsplit/
**/.git/
**/__pycache__/
*.pyc
.zcompdump*
.zsh_history
*.zwc
*.bak
*.save
*.backup-*
*~
/micro/backups/
/micro/buffers/
/zsh/.cache/
/zsh/vendor/ohmyzsh/cache/
/gtk-3.0/bookmarks
/MediaPlayer/*
!/MediaPlayer/mediaplayer.py
/wallpapers/*
!/wallpapers/*.jpg
!/wallpapers/*.png
!/wallpapers/current/
/wallpapers/current/*
!/wallpapers/current/wallpaper.jpg
/hypr/local.lua
/waybar/local.env
/zsh/local.zsh
.env
.env.*
*.key
*.pem
