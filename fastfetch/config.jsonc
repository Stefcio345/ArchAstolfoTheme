{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "padding": {
      "top": 0,
      "left": 1,
      "right": 3
    },
    "width": 28
  },

  "display": {
    "separator": "  ",
    "color": "#cfcfd4"
  },

  "modules": [
    {
      "type": "os",
      "key": "󰌢  DISTRO",
      "keyColor": "#f38ba8"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "#3a3a40"
    },
    {
      "type": "packages",
      "key": "│ └󰏖",
      "keyColor": "#3a3a40"
    },

    {
      "type": "wm",
      "key": "󱂬  INTERFACE",
      "keyColor": "#f38ba8"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "#3a3a40"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻",
      "keyColor": "#3a3a40"
    },
    // {
    //   "type": "cursor",
    //   "key": "│ ├",
    //   "keyColor": "#3a3a40"
    // },
    // {
    //   "type": "terminalfont",
    //   "key": "│ ├",
    //   "keyColor": "#3a3a40"
    // },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "#3a3a40"
    },
    {
      "type": "shell",
      "key": "│ └",
      "keyColor": "#3a3a40"
    },


    {
      "type": "board",
      "key": "󰘚  SYSTEM",
      "keyColor": "#f38ba8"
    },
    {
      "type": "cpu",
      "key": "  ├󰻠",
      "keyColor": "#3a3a40"
    },
    {
      "type": "gpu",
      "key": "  ├󰻑",
      "format": "{2}",
      "keyColor": "#3a3a40"
    },
    {
      "type": "display",
      "key": "  ├󰍹",
      "compactType": "original-with-refresh-rate",
      "keyColor": "#3a3a40"
    },

    {
      "type": "memory",
      "key": "  ├󰾆",
      "keyColor": "#3a3a40",
      "format": "{used} / {total}  ({#38;2;243;139;168}{percentage}{#})",
      "percent": {
        "type": 1
      }
    },

    {
      "type": "disk",
      "key": "  ├󰋊",
      "keyColor": "#3a3a40",
      "format": "{size-used} / {size-total}  ({#38;2;243;139;168}{size-percentage}{#})",
      "percent": {
        "type": 1
      }
    },

    // {
    //   "type": "sound",
    //   "key": "󰕾  AUDIO",
    //   "format": "{2}",
    //   "keyColor": "#f38ba8"
    // },
    // {
    //   "type": "player",
    //   "key": "  ├󰥠",
    //   "keyColor": "#3a3a40"
    // },
    // {
    //   "type": "media",
    //   "key": "  └󰝚",
    //   "keyColor": "#3a3a40"
    // },
  ]
}
